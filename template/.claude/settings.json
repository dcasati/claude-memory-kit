{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Write(memory/lessons/**)",
      "Write(memory/scratchpad/**)",
      "Write(memory/proposals/**)",
      "Edit(memory/MEMORY.md)",
      "Edit(memory/lessons/**)",
      "Edit(memory/scratchpad/**)",
      "Edit(memory/proposals/**)",
      "Bash(grep *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Write(memory/organization/**)",
      "Edit(memory/organization/**)",
      "Write(memory/errors/log.md)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "statusMessage": "Loading project memory…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/memory-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/memory-git.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/memory-error.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/token-guard.sh"
          }
        ]
      }
    ]
  }
}
